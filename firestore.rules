rules_version = '2';

// GENERATED from firebase/firestore.rules.template by `npm run rules`.
// Admin emails come from NEXT_PUBLIC_ADMIN_EMAILS — keep them in sync with Vercel.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['admin@offstagepr.in'];
    }

    // Categories are public so the website can build its filters.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anyone can read published events; drafts are admin-only.
    match /events/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // The public contact form can create enquiries (validated); only admins can read them.
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'type', 'message', 'read', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.type is string && request.resource.data.type.size() <= 40
        && request.resource.data.message is string && request.resource.data.message.size() <= 5000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
